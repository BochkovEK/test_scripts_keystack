# =============================================
# OpenStack Authentication
# =============================================
# OpenStack Keystone credentials
OS_AUTH_URL="http://keystone:5000/v3"
OS_USERNAME="monitor"
OS_PASSWORD="your_openstack_password"
OS_PROJECT_NAME="admin"
OS_USER_DOMAIN_NAME="Default"
OS_PROJECT_DOMAIN_NAME="Default"

# =============================================
# RabbitMQ Credentials
# =============================================
# RabbitMQ management API credentials
RABBIT_USER="guest"
RABBIT_PASS="guest_password"

# =============================================
# MySQL/Galera Credentials
# =============================================
# MySQL monitoring user credentials
MYSQL_USER="monitor"
MYSQL_PASS="mysql_password"
